<Project>

  <!-- Shared by every project in the solution (docs/PROJECT_SPEC.md §3.2). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    HID Aero SDK binaries (spec §2.1). Switch SDK builds by changing AeroSdkVersion
    or passing -p:AeroSdkVersion=4.8.1.3. Both DLLs must come from the same SDK package.
  -->
  <PropertyGroup>
    <AeroSdkVersion Condition="'$(AeroSdkVersion)' == ''">4.7.1.41</AeroSdkVersion>
    <AeroSdkDir>$(MSBuildThisFileDirectory)lib\HIDAero\$(AeroSdkVersion)\</AeroSdkDir>
  </PropertyGroup>

</Project>
