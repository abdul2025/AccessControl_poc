@model DoorFormViewModel
@{
    var isModal = ViewData[AccessControl.Web.Controllers.ModalFormController.IsModalViewDataKey] is true;
}

<form action="@Context.Request.Path@Context.Request.QueryString" method="post" asp-antiforgery="true" novalidate data-modal-form>
    <div class="modal-header">
        <div>
            <p class="eyebrow">@Model.ScpDisplayName</p>
            <h2 class="modal-title" id="hardware-form-title">@Model.Title</h2>
        </div>
        <partial name="_FormCloseButton" />
    </div>
    <div class="modal-body">
        <partial name="_DoorFields" model="Model" />
    </div>
    <div class="modal-footer">
        <a class="button button--secondary" asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" data-bs-dismiss="@(isModal ? "modal" : null)">Cancel</a>
        <button type="submit" class="button button--primary">Add door</button>
    </div>
</form>
