@model ScpListViewModel
@{
    ViewData["Title"] = "Controllers";
    var results = Model.Page;
    var filter = Model.Filter;
}

<section aria-labelledby="scps-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Configuration</p>
            <h1 id="scps-title">Controllers</h1>
        </div>
        @if (Model.SiteOptions.Count > 0)
        {
            <a class="button button--primary" asp-action="Create" asp-route-siteId="@filter.SiteId" data-modal>New controller</a>
        }
    </div>

    @if (Model.SiteOptions.Count == 0)
    {
        <p class="notice notice--info" role="status">
            Controllers belong to a site. <a asp-controller="Sites" asp-action="Index">Create a site</a> first.
        </p>
    }

    <form class="filter-bar" asp-action="Index" method="get" role="search" aria-label="Filter controllers">
        <div class="filter-bar__field filter-bar__field--search">
            <label for="scp-search">Search</label>
            <input id="scp-search" type="search" name="search" value="@filter.Search"
                   maxlength="@ScpListFilter.MaxSearchLength" autocomplete="off" placeholder="Name or IP address" />
        </div>
        <div class="filter-bar__field">
            <label for="scp-site">Site</label>
            <select id="scp-site" name="siteId" data-auto-submit>
                <option value="">All sites</option>
                @foreach (var site in Model.SiteOptions)
                {
                    <option value="@site.Id" selected="@(filter.SiteId == site.Id)">@site.DisplayName</option>
                }
            </select>
        </div>
        <div class="filter-bar__actions">
            <button type="submit" class="button button--primary">Apply</button>
            @if (!filter.IsEmpty)
            {
                <a class="button button--secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>

    @if (results.TotalCount == 0 && filter.IsEmpty)
    {
        <p class="empty-state">No controllers yet.</p>
    }
    else if (results.TotalCount == 0)
    {
        <p class="empty-state">No controllers match these filters. <a asp-action="Index">Clear filters</a></p>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">SCP</th>
                        <th scope="col">Name</th>
                        <th scope="col">Site</th>
                        <th scope="col">Connection</th>
                        <th scope="col">Identified by</th>
                        <th scope="col">Configuration</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in results.Items)
                    {
                        <tr>
                            <th scope="row">@item.ScpNumber</th>
                            <td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
                            <td>@item.SiteCode</td>
                            <td>@ScpLabels.ToLabel(item.ConnectionMode)</td>
                            <td>
                                @if (item.ConnectionMode == ConnectionMode.IpServer)
                                {
                                    @item.IpAddress
                                }
                                else if (item.SerialNumber is { } serial)
                                {
                                    @:Serial @serial
                                }
                                else
                                {
                                    <span class="field-hint">Awaiting adoption</span>
                                }
                            </td>
                            <td><partial name="_ScpSyncStatusBadge" model="item.SyncStatus" /></td>
                            <td class="actions-cell">
                                <a asp-action="Edit" asp-route-id="@item.Id" data-modal aria-label="Edit @item.Name" title="Edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" data-modal aria-label="Delete @item.Name" title="Delete">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (results.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (results.HasPreviousPage)
                {
                    <a asp-action="Index" asp-all-route-data="Model.RouteValues(page: results.Page - 1)">Previous</a>
                }
                <span>Page @results.Page of @results.TotalPages (@results.TotalCount controllers)</span>
                @if (results.HasNextPage)
                {
                    <a asp-action="Index" asp-all-route-data="Model.RouteValues(page: results.Page + 1)">Next</a>
                }
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        // Apply a select filter as soon as it changes; the Apply button covers no-JS use.
        document.addEventListener("change", (event) => {
            if (event.target.matches("[data-auto-submit]")) {
                event.target.form.requestSubmit();
            }
        });
    </script>
}
