@model SiteListViewModel
@{
    ViewData["Title"] = "Sites";
    var results = Model.Page;
    var filter = Model.Filter;
}

<section aria-labelledby="sites-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Configuration</p>
            <h1 id="sites-title">Sites</h1>
        </div>
        <a class="button button--primary" asp-action="Create" data-modal>New site</a>
    </div>

    <form class="filter-bar" asp-action="Index" method="get" role="search" aria-label="Filter sites">
        <div class="filter-bar__field filter-bar__field--search">
            <label for="site-search">Search</label>
            <input id="site-search" type="search" name="search" value="@filter.Search"
                   maxlength="@SiteListFilter.MaxSearchLength" autocomplete="off" placeholder="Code or name" />
        </div>
        <div class="filter-bar__actions">
            <button type="submit" class="button button--primary">Apply</button>
            @if (!filter.IsEmpty)
            {
                <a class="button button--secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>

    @if (results.TotalCount == 0 && filter.IsEmpty)
    {
        <p class="empty-state">No sites yet. Create the first site, then add its controllers.</p>
    }
    else if (results.TotalCount == 0)
    {
        <p class="empty-state">No sites match this search. <a asp-action="Index">Clear search</a></p>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Name</th>
                        <th scope="col">Controllers</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in results.Items)
                    {
                        <tr>
                            <th scope="row"><a asp-action="Details" asp-route-id="@item.Id">@item.Code</a></th>
                            <td>@item.Name</td>
                            <td>@item.ScpCount</td>
                            <td class="actions-cell">
                                <a asp-action="Edit" asp-route-id="@item.Id" data-modal aria-label="Edit @item.Code" title="Edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" data-modal aria-label="Delete @item.Code" title="Delete">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (results.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (results.HasPreviousPage)
                {
                    <a asp-action="Index" asp-all-route-data="Model.RouteValues(page: results.Page - 1)">Previous</a>
                }
                <span>Page @results.Page of @results.TotalPages (@results.TotalCount sites)</span>
                @if (results.HasNextPage)
                {
                    <a asp-action="Index" asp-all-route-data="Model.RouteValues(page: results.Page + 1)">Next</a>
                }
            </nav>
        }
    }
</section>
