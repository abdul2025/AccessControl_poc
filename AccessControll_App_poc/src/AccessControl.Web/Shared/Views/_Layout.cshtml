@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Access Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AccessControl.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Main">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Access Control</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="main-navigation" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @foreach (var (controller, label) in new[] { ("Home", "Home"), ("Sites", "Sites"), ("Scps", "Controllers") })
                        {
                            var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a class="nav-link text-dark @(isActive ? "is-active" : "")" asp-controller="@controller" asp-action="Index"
                                   aria-current="@(isActive ? "page" : null)">@label</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main id="main-content" class="pb-3" tabindex="-1">
            <partial name="_StatusMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">Access Control POC</div>
    </footer>

    @* Shared modal for create / edit / delete forms (modal-forms.js). *@
    <div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modal-forms.js" asp-append-version="true"></script>
    <script src="~/js/scp-form.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
