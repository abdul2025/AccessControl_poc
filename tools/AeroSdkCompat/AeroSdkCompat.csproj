<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HID Aero SDK compatibility probe for .NET 10.
    Pick the driver build with:  dotnet run -p:AeroSdkVersion=4.8.1.3
    DLLs are read from AccessControll_App_poc/lib/HIDAero/<AeroSdkVersion>/ (HIDAeroNet64.dll + HIDAeroWrap64.dll),
    the same binaries the application uses.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Aero driver is a native Windows x64 DLL (docs/PROJECT_SPEC.md §2). -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AeroSdkVersion Condition="'$(AeroSdkVersion)' == ''">4.7.1.41</AeroSdkVersion>
    <AeroSdkDir>$(MSBuildThisFileDirectory)..\..\AccessControll_App_poc\lib\HIDAero\$(AeroSdkVersion)\</AeroSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HIDAeroWrap64">
      <HintPath>$(AeroSdkDir)HIDAeroWrap64.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(AeroSdkDir)HIDAeroNet64.dll" Link="HIDAeroNet64.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="CheckAeroSdkDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AeroSdkDir)HIDAeroWrap64.dll') Or !Exists('$(AeroSdkDir)HIDAeroNet64.dll')"
           Text="HID Aero SDK $(AeroSdkVersion) not found. Put HIDAeroNet64.dll and HIDAeroWrap64.dll in $(AeroSdkDir)" />
  </Target>

</Project>
